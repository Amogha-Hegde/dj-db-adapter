# dj-db-adapter sample environment file
# Copy the variables you need into your real environment.

# -----------------------------------------------------------------------------
# Aliases
# -----------------------------------------------------------------------------
DJ_DB_ALIASES=postgres_default,sqlite_local,mysql_app,oracle_standard,oracle_easy,oracle_full,cockroach_app,firebird_app,spanner_app,mssql_app,snowflake_app,tidb_app,yugabyte_app,mongodb_app

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DJ_DB_POSTGRES_DEFAULT_BACKEND=postgres
DJ_DB_POSTGRES_DEFAULT_POSTGRES_NAME=app_db
DJ_DB_POSTGRES_DEFAULT_POSTGRES_USER=app_user
DJ_DB_POSTGRES_DEFAULT_POSTGRES_PASSWORD=change-me
DJ_DB_POSTGRES_DEFAULT_POSTGRES_HOST=postgres.example.com
DJ_DB_POSTGRES_DEFAULT_POSTGRES_PORT=5432
DJ_DB_POSTGRES_DEFAULT_POSTGRES_CONN_MAX_AGE=120
DJ_DB_POSTGRES_DEFAULT_POSTGRES_CONN_HEALTH_CHECKS=true
DJ_DB_POSTGRES_DEFAULT_POSTGRES_AUTOCOMMIT=false
DJ_DB_POSTGRES_DEFAULT_POSTGRES__OPTIONS__APPLICATION_NAME=dj-db-adapter
DJ_DB_POSTGRES_DEFAULT_POSTGRES__OPTIONS__SEARCH_PATH=public

# -----------------------------------------------------------------------------
# SQLite
# -----------------------------------------------------------------------------
DJ_DB_SQLITE_LOCAL_BACKEND=sqlite
DJ_DB_SQLITE_LOCAL_SQLITE_NAME=/tmp/app.sqlite3

# -----------------------------------------------------------------------------
# MySQL / MariaDB
# -----------------------------------------------------------------------------
DJ_DB_MYSQL_APP_BACKEND=mysql
DJ_DB_MYSQL_APP_MYSQL_NAME=app_db
DJ_DB_MYSQL_APP_MYSQL_USER=app_user
DJ_DB_MYSQL_APP_MYSQL_PASSWORD=change-me
DJ_DB_MYSQL_APP_MYSQL_HOST=mysql.example.com
DJ_DB_MYSQL_APP_MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Oracle Standard
# -----------------------------------------------------------------------------
DJ_DB_ORACLE_STANDARD_BACKEND=oracle
DJ_DB_ORACLE_STANDARD_ORACLE_HOST=oracle.example.com
DJ_DB_ORACLE_STANDARD_ORACLE_PORT=1521
DJ_DB_ORACLE_STANDARD_ORACLE_NAME=ORCLCDB
DJ_DB_ORACLE_STANDARD_ORACLE_USER=scott
DJ_DB_ORACLE_STANDARD_ORACLE_PASSWORD=tiger

# -----------------------------------------------------------------------------
# Oracle Easy Connect
# -----------------------------------------------------------------------------
DJ_DB_ORACLE_EASY_BACKEND=oracle
DJ_DB_ORACLE_EASY_ORACLE_NAME=dbhost.example.com:1521/ORCLPDB1
DJ_DB_ORACLE_EASY_ORACLE_USER=reporter
DJ_DB_ORACLE_EASY_ORACLE_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Oracle Full Descriptor
# -----------------------------------------------------------------------------
DJ_DB_ORACLE_FULL_BACKEND=oracle
DJ_DB_ORACLE_FULL_ORACLE_PROTOCOL=tcp
DJ_DB_ORACLE_FULL_ORACLE_HOST=oracle.example.com
DJ_DB_ORACLE_FULL_ORACLE_PORT=1521
DJ_DB_ORACLE_FULL_ORACLE_SERVICE_NAME=ORCLPDB1
DJ_DB_ORACLE_FULL_ORACLE_USER=warehouse
DJ_DB_ORACLE_FULL_ORACLE_PASSWORD=change-me

# -----------------------------------------------------------------------------
# CockroachDB
# -----------------------------------------------------------------------------
DJ_DB_COCKROACH_APP_BACKEND=cockroach
DJ_DB_COCKROACH_APP_COCKROACH_NAME=app_db
DJ_DB_COCKROACH_APP_COCKROACH_USER=app_user
DJ_DB_COCKROACH_APP_COCKROACH_PASSWORD=change-me
DJ_DB_COCKROACH_APP_COCKROACH_HOST=cockroach.example.com
DJ_DB_COCKROACH_APP_COCKROACH_PORT=26257

# -----------------------------------------------------------------------------
# Firebird
# -----------------------------------------------------------------------------
DJ_DB_FIREBIRD_APP_BACKEND=firebird
DJ_DB_FIREBIRD_APP_FIREBIRD_NAME=/srv/firebird/app.fdb
DJ_DB_FIREBIRD_APP_FIREBIRD_USER=sysdba
DJ_DB_FIREBIRD_APP_FIREBIRD_PASSWORD=change-me
DJ_DB_FIREBIRD_APP_FIREBIRD_HOST=firebird.example.com
DJ_DB_FIREBIRD_APP_FIREBIRD_PORT=3050

# -----------------------------------------------------------------------------
# Google Cloud Spanner
# -----------------------------------------------------------------------------
DJ_DB_SPANNER_APP_BACKEND=spanner
DJ_DB_SPANNER_APP_SPANNER_PROJECT=my-gcp-project
DJ_DB_SPANNER_APP_SPANNER_INSTANCE=app-instance
DJ_DB_SPANNER_APP_SPANNER_NAME=app-database

# -----------------------------------------------------------------------------
# Microsoft SQL Server
# -----------------------------------------------------------------------------
DJ_DB_MSSQL_APP_BACKEND=mssql
DJ_DB_MSSQL_APP_MSSQL_NAME=app_db
DJ_DB_MSSQL_APP_MSSQL_USER=sa
DJ_DB_MSSQL_APP_MSSQL_PASSWORD=change-me
DJ_DB_MSSQL_APP_MSSQL_HOST=mssql.example.com
DJ_DB_MSSQL_APP_MSSQL_PORT=1433

# -----------------------------------------------------------------------------
# Snowflake
# -----------------------------------------------------------------------------
DJ_DB_SNOWFLAKE_APP_BACKEND=snowflake
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_NAME=analytics
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_USER=reporter
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_PASSWORD=change-me
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_ACCOUNT=xy12345.eu-central-1
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_SCHEMA=PUBLIC
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
DJ_DB_SNOWFLAKE_APP_SNOWFLAKE_ROLE=ANALYST

# -----------------------------------------------------------------------------
# TiDB
# -----------------------------------------------------------------------------
DJ_DB_TIDB_APP_BACKEND=tidb
DJ_DB_TIDB_APP_TIDB_NAME=app_db
DJ_DB_TIDB_APP_TIDB_USER=root
DJ_DB_TIDB_APP_TIDB_PASSWORD=change-me
DJ_DB_TIDB_APP_TIDB_HOST=tidb.example.com
DJ_DB_TIDB_APP_TIDB_PORT=4000

# -----------------------------------------------------------------------------
# YugabyteDB
# -----------------------------------------------------------------------------
DJ_DB_YUGABYTE_APP_BACKEND=yugabyte
DJ_DB_YUGABYTE_APP_YUGABYTE_NAME=app_db
DJ_DB_YUGABYTE_APP_YUGABYTE_USER=yugabyte
DJ_DB_YUGABYTE_APP_YUGABYTE_PASSWORD=change-me
DJ_DB_YUGABYTE_APP_YUGABYTE_HOST=yugabyte.example.com
DJ_DB_YUGABYTE_APP_YUGABYTE_PORT=5433

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
DJ_DB_MONGODB_APP_BACKEND=mongodb
DJ_DB_MONGODB_APP_MONGODB_NAME=analytics
DJ_DB_MONGODB_APP_MONGODB_HOST=mongodb://mongo.example.com:27017/analytics

# -----------------------------------------------------------------------------
# URL-based alternative examples
# -----------------------------------------------------------------------------
# DJ_DB_DEFAULT_URL=postgres://app_user:change-me@postgres.example.com:5432/app_db
# DJ_DB_ANALYTICS_URL=mysql://app_user:change-me@mysql.example.com:3306/analytics

# -----------------------------------------------------------------------------
# File-based alternative examples
# -----------------------------------------------------------------------------
# DJ_DB_ARCHIVE_CONFIG_FILE=/etc/myapp/archive.json
# DJ_DB_REPORTING_CONFIG_FILE=/etc/myapp/reporting.ini

# -----------------------------------------------------------------------------
# Engine override example
# -----------------------------------------------------------------------------
# DJ_DB_POSTGRES_DEFAULT_ENGINE=django.db.backends.postgresql_psycopg2
